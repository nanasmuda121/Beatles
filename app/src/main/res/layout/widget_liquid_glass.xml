<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Single-layer ultra-clear 3D Liquid Glass lens backdrop -->
    <ImageView
        android:id="@+id/widget_glass_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_liquid_glass_bg"
        android:contentDescription="@null" />

    <!-- Main interior padding container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Top Row: Floating Glass Album Art + Song Info + Liquid Glass Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Framed Album Artwork -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/widget_liquid_glass_album_frame"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/widget_glass_album_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_music_placeholder"
                    android:contentDescription="@string/widget_album_art" />
            </FrameLayout>

            <!-- Song Title, Artist & Progress Bar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_glass_song_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/no_song_playing"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:shadowColor="#B3000000"
                        android:shadowDy="1"
                        android:shadowRadius="6" />

                    <TextView
                        android:id="@+id/widget_glass_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/widget_liquid_glass_badge_bg"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="GLASS"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:shadowColor="#99000000"
                        android:shadowRadius="4" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_glass_artist_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/tap_to_open"
                    android:textColor="#F2FFFFFF"
                    android:textSize="12.5sp"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="5" />

                <!-- Liquid Glass Glowing Progress Bar -->
                <ProgressBar
                    android:id="@+id/widget_glass_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4.5dp"
                    android:layout_marginTop="8dp"
                    android:max="10000"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_liquid_glass_progress" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Row: Translucent Glass Pill Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_glass_like_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_liquid_glass_btn_circle"
                android:padding="9dp"
                android:src="@drawable/ic_widget_heart_outline_nav"
                android:contentDescription="@string/widget_like_button" />

            <ImageView
                android:id="@+id/widget_glass_previous"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/widget_liquid_glass_btn_circle"
                android:padding="10dp"
                android:src="@drawable/ic_widget_skip_previous"
                android:contentDescription="Sebelumnya" />

            <ImageView
                android:id="@+id/widget_glass_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/widget_liquid_glass_play_pill"
                android:padding="12dp"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="@string/widget_play_pause" />

            <ImageView
                android:id="@+id/widget_glass_next"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/widget_liquid_glass_btn_circle"
                android:padding="10dp"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="Berikutnya" />

            <ImageView
                android:id="@+id/widget_glass_open_app"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_liquid_glass_btn_circle"
                android:padding="9dp"
                android:src="@drawable/ic_widget_music_logo"
                android:contentDescription="Buka Aplikasi" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
