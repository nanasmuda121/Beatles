<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glass_square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_glass_square_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_liquid_glass_bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp">

        <ImageView
            android:id="@+id/widget_glass_square_album_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_music_placeholder"
            android:contentDescription="@string/widget_album_art" />

        <TextView
            android:id="@+id/widget_glass_square_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/no_song_playing"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_glass_square_previous"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_liquid_glass_btn_circle"
                android:padding="7dp"
                android:src="@drawable/ic_widget_skip_previous"
                android:contentDescription="Sebelumnya" />

            <ImageView
                android:id="@+id/widget_glass_square_play_pause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_liquid_glass_play_pill"
                android:padding="9dp"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="@string/widget_play_pause" />

            <ImageView
                android:id="@+id/widget_glass_square_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_liquid_glass_btn_circle"
                android:padding="7dp"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="Berikutnya" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
